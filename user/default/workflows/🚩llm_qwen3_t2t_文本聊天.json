s/`）\n\n### 3. 输出\nAI生成的文字回复，可在「预览任意」节点查看结果文本\n\n### 4. 使用方法\n1. 将`qwen_3_4b.safetensors`放到`ComfyUI/models/text_encoders/`目录\n2. 在TextGenerate提示词框输入提问内容\n3. 运行工作流，在预览节点获取AI返回的文字答案\n"],"color":"#222","bgcolor":"#000"},{"id":8,"type":"CLIPLoader","pos":[340,3370],"size":[270,140],"flags":{},"order":1,"mode":0,"inputs":[{"localized_name":"CLIP名称","name":"clip_name","type":"COMBO","widget":{"name":"clip_name"},"link":null},{"localized_name":"类型","name":"type","type":"COMBO","widget":{"name":"type"},"link":null},{"localized_name":"设备","name":"device","shape":7,"type":"COMBO","widget":{"name":"device"},"link":null}],"outputs":[{"localized_name":"CLIP","name":"CLIP","type":"CLIP","links":[7]}],"properties":{"Node name for S&R":"CLIPLoader","cnr_id":"comfy-core","ver":"0.14.1","models":[{"name":"qwen_3_4b.safetensors","url":"https://huggingface.co/Comfy-Org/flux2-klein/resolve/main/split_files/text_encoders/qwen_3_4b.safetensors","directory":"text_encoders"}],"enableTabs":false,"tabWidth":65,"tabXOffset":10,"hasSecondTab":false,"secondTabText":"Send Back","secondTabOffset":80,"secondTabWidth":65,"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["qwen_3_4b.safetensors","ltxv","default"]},{"id":11,"type":"MarkdownNote","pos":[340,3569.0271258797166],"size":[260,150],"flags":{},"order":2,"mode":0,"inputs":[],"outputs":[],"title":"Supported Model","properties":{"ue_properties":{"widget_ue_connectable":{},"version":"7.8","input_ue_unconnectable":{}}},"widgets_values":["For Qwen 3.0, ComfyUI only supports the 4B model at the moment (2026/3)."],"color":"#222","bgcolor":"#000"}],"links":[[7,8,0,7,0,"CLIP"],[8,7,0,5,0,"STRING"]],"groups":[],"config":{},"extra":{"ds":{"scale":0.5445000000000007,"offset":[2202.848907815788,-4154.128178840297]},"frontendVersion":"1.39.19","workflowRendererVersion":"LG","VHS_latentpreview":false,"VHS_latentpreviewrate":0,"VHS_MetadataImage":true,"VHS_KeepIntermediate":true,"ue_links":[],"links_ad